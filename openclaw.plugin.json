{
  "id": "x-claude-code",
  "name": "X Claude Code",
  "description": "Claude Code models through an AxonHub gateway (Anthropic format)",
  "categories": [
    "models"
  ],
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": [
    "x-claude-code"
  ],
  "setup": {
    "providers": [
      {
        "id": "x-claude-code",
        "envVars": [
          "X_CLAUDE_CODE_API_KEY"
        ]
      }
    ]
  },
  "modelCatalog": {
    "discovery": {
      "x-claude-code": "refreshable"
    }
  },
  "providerAuthChoices": [
    {
      "provider": "x-claude-code",
      "method": "api-key",
      "choiceId": "x-claude-code-api-key",
      "appGuidedSecret": true,
      "choiceLabel": "Claude Code API key",
      "groupId": "x-claude-code",
      "groupLabel": "X Claude Code",
      "groupHint": "Key restricted to the Claude Code channel",
      "optionKey": "xClaudeCodeApiKey",
      "cliFlag": "--x-claude-code-api-key",
      "cliOption": "--x-claude-code-api-key <key>",
      "cliDescription": "Claude Code API key"
    }
  ],
  "uiHints": {
    "baseUrl": {
      "label": "API address",
      "placeholder": "https://axonhub.example.com/anthropic",
      "help": "Overrides X_CLAUDE_CODE_BASE_URL"
    },
    "apiKey": {
      "label": "API key",
      "placeholder": "ah-...",
      "sensitive": true,
      "help": "Overrides the saved auth profile and X_CLAUDE_CODE_API_KEY"
    },
    "contextWindow": {
      "label": "Context window",
      "placeholder": "1000000",
      "help": "Empty: models.dev, then 1M. Overrides X_CLAUDE_CODE_CONTEXT_WINDOW"
    },
    "modelsDev": {
      "label": "Limits from models.dev",
      "help": "On by default: fills context window and output limits from models.dev for models AxonHub reports without them. Overrides X_CLAUDE_CODE_MODELS_DEV"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string"
      },
      "apiKey": {
        "type": "string"
      },
      "contextWindow": {
        "type": "integer",
        "minimum": 1
      },
      "modelsDev": {
        "type": "boolean",
        "default": true
      }
    }
  }
}
